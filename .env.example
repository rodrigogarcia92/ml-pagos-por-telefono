# Project-level environment variables.
# Loaded automatically by VS Code (Python extension reads this file).
# Also used later by python-dotenv when we add secrets (e.g. DB credentials).

# Force UTF-8 as Python's default encoding on Windows.
# Prevents UnicodeDecodeError on Spanish characters from the BCRP API.
PYTHONUTF8=1
GCP_PROJECT_ID=pagos-telefono-26
BQ_DATASET_RAW=raw
BQ_DATASET_STAGING=staging
BQ_DATASET_MARTS=marts
# --- MLflow (roadmap step 7) ------------------------------------------------
# The tracking server started by scripts/start_mlflow.ps1. Read by mlflow
# automatically; src/model_training/tracking.py calls load_dotenv() so the
# variable is never hardcoded and the same code can point at a remote server
# later without an edit.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_PREFIX=26.1__
