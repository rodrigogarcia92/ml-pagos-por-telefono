# --- Secrets & credentials -------------------------------------------------
.env
*-service-account*.json
gcp-key*.json
credentials.json

# --- Virtual environments --------------------------------------------------
.venv/
.venv-dbt/
venv/
env/

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Derived data ----------------------------------------------------------
# data/raw/ IS committed: 21 small JSON snapshots (~80 KB) that make the whole
# pipeline reproducible from the repo alone. Everything below is regenerable.
# That includes the training snapshots in data/processed/ — panel_*.parquet and
# series_meta_*.csv are rebuilt by snapshot.py from the warehouse, which is in
# turn rebuilt from data/raw/. See training_plan.md §4.0.
data/interim/
data/processed/
data/external/
!data/**/.gitkeep

# --- Models & experiments --------------------------------------------------
models/*
!models/.gitkeep
# MLflow. NOTE: gitignore has no inline comments -- text after a pattern
# becomes part of the pattern, which silently un-ignores it.
# mlflow/ holds the SQLite tracking DB and its dated backups. It IS the
# experiment history and lives ONLY on the development machine (artifacts go to GCS, runs do not).
mlflow/
# MLflow's default file store; unused, but easy to create by accident by
# running without --backend-store-uri.
mlruns/
# local artifact root if --serve-artifacts is ever dropped
mlartifacts/
# a stray DB at repo root (mlflow/ covers the real one)
mlflow.db

# --- Reports ---------------------------------------------------------------
reports/**/*.png
reports/**/*.html
!reports/.gitkeep

# --- dbt -------------------------------------------------------------------
target/
dbt_packages/
logs/
profiles.yml

# --- OS / editor -----------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store

# --- Tooling scratch (not part of the project) -----------------------------
.kilo/
Claude outputs/

# Written into the workspace by google-github-actions/auth in the monthly refresh; it would
# make the forecast record a dirty tree.
gha-creds-*.json
